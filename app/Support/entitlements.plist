<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ══════════════════════════════════════════════════════════════════
	     TrollStore 权限配置（含 A12+ 启动限制）
	     ══════════════════════════════════════════════════════════════════

	     用户要求：「把我们现在所有的功能全部给这个 root 权限呢
	                和这个这些权限都要给够 都是这个巨魔安装的权限都有」

	     TrollStore 可保留私有权限，但不能绕过 A12+ / iOS 15+ 的
	     PPL 禁止项：cs.debugger、dynamic-codesigning、skip-library-validation。
	     这些权限会让主程序在 main() 前启动失败，不能加入。
	     参考：https://github.com/opa334/TrollStore#banned-entitlements

	     三个来源都对齐了：
	       · 白米饭原版 7 项（逐条从 Mach-O 里扣出来核对过，我们原本一字不差）
	       · TrollSpeed 23 项（Lessica 开源，ch.xxtou.hudapp）
	       · TrollStore 时代通用高权限集

	     ⚠️ 说明：entitlements 只对【本进程】生效。
	        子进程要 root 得靠 posix_spawn 的 persona 参数，
	        见 MFHUDLauncher.mm（persona 99 + uid 0 + gid 0）。
	     ══════════════════════════════════════════════════════════════════ -->

	<!-- ── 身份 ── -->
	<key>application-identifier</key>
	<string>com.apple.findmy</string>
	<key>platform-application</key>
	<true/>

	<!-- ── ★★★ 显示链路（HUD 悬浮窗的核心）─── -->
	<key>com.apple.QuartzCore.displayable-context</key>
	<true/>
	<key>com.apple.QuartzCore.secure-mode</key>
	<true/>
	<key>com.apple.backboard.client</key>
	<true/>

	<!-- ── 沙盒完全豁免 ── -->
	<key>com.apple.private.security.no-sandbox</key>
	<true/>
	<key>com.apple.private.security.container-required</key>
	<false/>
	<key>com.apple.private.security.no-container</key>
	<true/>
	<key>com.apple.private.security.storage.AppBundles</key>
	<true/>
	<key>com.apple.private.security.storage.AppDataContainers</key>
	<true/>

	<!-- ── 进程 / 调试 / 任务端口 ── -->
	<key>task_for_pid-allow</key>
	<true/>
	<key>get-task-allow</key>
	<true/>
	<key>com.apple.system-task-ports</key>
	<true/>
	<key>com.apple.system-task-ports.read</key>
	<true/>

	<!-- ── 越狱 / rootful 安装 ── -->
	<key>com.apple.rootless.install</key>
	<true/>
	<key>com.apple.rootless.install.heritable</key>
	<true/>
	<key>com.apple.private.persona-mgmt</key>
	<true/>
	<key>com.apple.private.amfi.can-load-cdhash</key>
	<true/>
	<key>com.apple.private.amfi.can-validate-boot-args</key>
	<true/>

	<!-- ── HUD 跨 App 窗口托管 ── -->
	<key>com.apple.springboard.accessibility-window-hosting</key>
	<true/>
	<key>com.apple.springboard.appbackgroundstyle</key>
	<true/>
	<key>com.apple.springboard.CFUserNotification</key>
	<true/>
	<key>com.apple.springboard.disallowControlCenter</key>
	<true/>
	<key>com.apple.springboard.disallowNotificationCenter</key>
	<true/>
	<key>com.apple.springboard.opensensitiveurl</key>
	<true/>

	<!-- ── HID 事件（HUD 菜单要能收到触摸）─── -->
	<key>com.apple.private.hid.client.event-dispatch</key>
	<true/>
	<key>com.apple.private.hid.client.event-filter</key>
	<true/>
	<key>com.apple.private.hid.client.event-monitor</key>
	<true/>
	<key>com.apple.private.hid.client.service-protected</key>
	<true/>
	<key>com.apple.private.hid.manager.client</key>
	<true/>
	<key>com.apple.private.allow-background-haptics</key>
	<true/>

	<!-- ── IOKit 用户客户端（GPU / Surface / NVRAM / 硬件）─── -->
	<key>com.apple.security.exception.iokit-user-client-class</key>
	<array>
		<string>AGXDeviceUserClient</string>
		<string>IOSurfaceRootUserClient</string>
		<string>AppleSMC</string>
		<string>IOHIDEventServiceFastPathUserClient</string>
		<string>AppleNVMe</string>
		<string>IOUSBDeviceInterface</string>
	</array>
	<key>com.apple.private.iokit.nvram-write-access</key>
	<true/>
	<key>com.apple.private.iokit.system-nvram</key>
	<true/>
	<key>com.apple.private.iokit.allow-accelerometer</key>
	<true/>
	<key>com.apple.private.iokit.serial-port</key>
	<true/>

	<!-- ── 内核 / 内存 ── -->
	<key>com.apple.private.memorystatus</key>
	<true/>
	<key>com.apple.private.kernel.jetsam</key>
	<true/>
	<key>com.apple.private.kernel.get-kext-info</key>
	<true/>
	<key>com.apple.private.kernel.global-control</key>
	<true/>
	<key>com.apple.private.kernel.kdebug</key>
	<true/>

	<!-- ── launchd / XPC ── -->
	<key>com.apple.private.xpc.launchd</key>
	<true/>
	<key>com.apple.private.xpc.launchd.job-manager</key>
	<true/>
	<key>com.apple.security.exception.mach-lookup.global-name</key>
	<array>
		<string>com.apple.springboard.services</string>
		<string>com.apple.backboardd</string>
		<string>com.apple.frontboard.systemappservices</string>
		<string>com.apple.runningboardd</string>
		<string>com.apple.distnoted.xpc.daemon</string>
		<string>com.apple.system.notification_center</string>
	</array>

	<!-- ── 文件系统 ── -->
	<key>file-read-data</key>
	<true/>
	<key>com.apple.security.exception.files.absolute-path.read-write</key>
	<array>
		<string>/</string>
	</array>
	<key>com.apple.private.security.storage.MobileAssetGenerativeModels</key>
	<true/>

	<!-- ── 系统状态 / 账号 ── -->
	<key>com.apple.private.MobileGestalt.AllowedProtectedKeys</key>
	<true/>
	<key>com.apple.private.accounts.allaccounts</key>
	<true/>
	<key>com.apple.private.tcc.allow</key>
	<true/>
	<key>com.apple.private.tcc.manager</key>
	<true/>
	<key>com.apple.private.aps-connection-initiate</key>
	<true/>
	<key>com.apple.private.diskimages.kext.user-client-access</key>
	<true/>

	<!-- ── 偏好设置 ── -->
	<key>user-preference-read</key>
	<true/>
	<key>user-preference-write</key>
	<true/>

	<!-- ── 其它常见的高权限位 ── -->
	<key>com.apple.private.sandbox.profile</key>
	<string>com.apple.uikit.viewservice</string>
	<key>com.apple.private.network.socket-delegate</key>
	<true/>
	<key>com.apple.private.network.socket-info</key>
	<true/>
	<key>com.apple.private.network.statistics</key>
	<true/>
	<key>com.apple.private.networkextension.configuration</key>
	<true/>
	<key>com.apple.private.sysctl.allow</key>
	<true/>
	<key>com.apple.private.kernel.override-cpumon</key>
	<true/>
	<key>com.apple.private.cpu-throttle</key>
	<true/>
	<key>com.apple.private.vfs.authorized-access</key>
	<true/>
	<key>com.apple.private.vfs.open-by-id</key>
	<true/>
	<key>com.apple.private.mobile.host-identifiers</key>
	<true/>
	<key>com.apple.private.security.disk-device-access</key>
	<true/>
</dict>
</plist>
