<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>

	<!-- ======== 伪装身份：系统「查找」=======
	     CFBundleIdentifier = com.apple.findmy  （来源：joeblau/apple-bundle-identifiers，Find My iOS 13+）
	     系统按已注册的 bundle ID + 路径启动可执行文件 → 图标点开即我方 UI
	========================================= -->
	<key>CFBundleDisplayName</key>
	<string>查找</string>
	<key>CFBundleIdentifier</key>
	<string>com.apple.findmy</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>FindMy</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh_CN</string>
		<string>zh-Hans</string>
		<string>en</string>
	</array>

	<!-- ======== 系统要求 ======== -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>

	<!-- ======== 界面 ======== -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIRequiresFullScreen</key>
	<true/>
	<!-- iPhone ProMotion opt-in; iPad Pro does not require this special key. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  [M5.18] 对照白米饭 Info.plist 补的两个键（原版有、我们没有）：

	    UIApplicationShowsViewsWhileLocked  = true
	    UIApplicationSystemWindowsSecureKey = true

	  它们让窗口在锁屏时也显示、并按「系统安全窗口」处理 ——
	  跨 App 悬浮（SBSAccessibilityWindowHostingController 那条路）需要。

	  分析报告已证原版的 DrawingWindow 上
	    _isSystemWindow / _isSecure / _shouldCreateContextAsSecure / _ignoresHitTest
	  全部直接返回 1，和这两个键是一套机制。

	  ⚠️ 故意【不加】 NSPrincipalClass：
	     它的作用是给 UIApplicationMain(argc,argv,nil,...) 提供 UIApplication 的类。
	     原版写 HUDMainApplication。但我们主 App 也走同一条 nil 分支，
	     加上去会让控制台进程也用 HUD 的 Application 类。
	     我们改成在代码里显式指定（MFLaunchHUDRole 里
	     UIApplicationInstantiateSingleton([MFHUDApplication class])），
	     效果一致且不影响主 App。
	-->
	<key>UIApplicationShowsViewsWhileLocked</key>
	<true/>
	<key>UIApplicationSystemWindowsSecureKey</key>
	<true/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- ======== 桌面长按快捷操作：切换悬浮窗 ======== -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>wand.and.stars</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>切换悬浮窗</string>
			<key>UIApplicationShortcutItemType</key>
			<string>com.mf.shortcut.toggle-hud</string>
		</dict>
	</array>
</dict>
</plist>
